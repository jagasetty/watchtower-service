	@PostMapping(value = "/v1/setUNIStatus", consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> setUNIStatus(@RequestBody Map<String, Object> assignedInventoryBody) {
		log.info("=> setUNIStatus (): START");
		log.info(" Update UNI Circuit Status : '{}'", assignedInventoryBody.toString());
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");
		
		 // Set circuitType as UNI
	    assignedInventoryBody.put("circuitType", "UNI");

		// Validate the request
		ResponseEntity<String> validationResponse = validator.validate(assignedInventoryBody);
		if (validationResponse != null) {
			responseStatus.setCode(HttpStatus.BAD_REQUEST.value());
			responseStatus.setMessage(validationResponse.getBody());
			return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.BAD_REQUEST.value()));
		}
		try {
			responseStatus = ethOrderSrvc.setCircuitStatus(assignedInventoryBody);
		} catch (Exception ex) {
			log.error("setUNIStatus -Caught Exception:- '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed to update UNI Circuit status Reason : " + ex.getMessage());
		}
		log.info("<= setUNIStatus (): END");
		HttpStatus httpStatus;
	    switch (responseStatus.getCode()) {
	        case 200:
	            httpStatus = HttpStatus.OK;
	            break;
	        case 400:
	            httpStatus = HttpStatus.BAD_REQUEST;
	            break;
	        case 404:
	            httpStatus = HttpStatus.NOT_FOUND;
	            break;
	        default:
	            httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
	            break;
	    }
	    return new ResponseEntity<>(responseStatus, httpStatus);
	}

