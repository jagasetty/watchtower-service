	@GetMapping("v1/getServiceDesign")
	public ResponseEntity<?> getServiceDesign(@RequestParam(value = "circuit", required = false) String circuit) {
		log.info("=>getServiceDesign(): START");
		log.info("Get Service design : '{}'", circuit);
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setCode(500);
		responseStatus.setMessage("Failed");
		HttpStatus httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;

		try {
			if (StringUtils.isBlank(circuit)) {
				String msgStr = "Empty EVC/OVC name is not allowed!.";
				log.error("Failed: '{}'", msgStr);
				responseStatus.setCode(HttpStatus.BAD_REQUEST.value());
				responseStatus.setMessage(msgStr);
			} else {
				responseStatus = ethOrderSrvc.getEVCDesign(circuit);
				switch (responseStatus.getCode()) {
				case 200:
					httpStatus = HttpStatus.OK;
					break;
				case 204:
					httpStatus = HttpStatus.NO_CONTENT;
					break;
				case 400:
					httpStatus = HttpStatus.BAD_REQUEST;
					break;
				case 404:
					httpStatus = HttpStatus.NOT_FOUND;
					break;
				case 500:
				default:
					httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
					break;
				}
			}
		} catch (Exception ex) {
			log.error("Get Service design-Caught Exception:- '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed : " + ex.getMessage());
		}
		log.info("<=getServiceDesign(): END");
		return new ResponseEntity<>(responseStatus, httpStatus);
	}

