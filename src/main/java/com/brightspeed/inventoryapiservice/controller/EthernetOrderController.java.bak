	@PostMapping(value = "/v1/disconnectUNI", consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> disconnectUNI(@RequestBody Map<String, Object> uniInfo) {
		log.info("=> disconnectUNI(): START");
		log.info("Input : '{}'", uniInfo.toString());

		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");

		try {
			boolean hardDisconnect = uniInfo.get("hardDisconnect") != null && (Boolean) uniInfo.get("hardDisconnect");
			if (hardDisconnect) {
				responseStatus = ethOrderSrvc.hardDisconnectUNI(uniInfo);
			} else {
				responseStatus = ethOrderSrvc.disconnectUNI(uniInfo);
			}
		} catch (Exception ex) {
			log.error("disconnectOrDeleteUNI - Exception: '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Error occurred: " + ex.getMessage());
		}

		log.info("<= disconnectOrDeleteUNI(): END");
		HttpStatus httpStatus;
		switch (responseStatus.getCode()) {
		case 200:
			httpStatus = HttpStatus.OK;
			break;
		case 400:
			httpStatus = HttpStatus.BAD_REQUEST;
			break;
		case 404:
			httpStatus = HttpStatus.NOT_FOUND;
			break;
		case 207:
			httpStatus = HttpStatus.MULTI_STATUS;
			break;
		default:
			httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
			break;
		}
		return new ResponseEntity<>(responseStatus, httpStatus);
	}

	@GetMapping(value = "/v1/getFiberConnectionInfo")
	public ResponseEntity<?> getFiberConnectionInfo(@RequestParam(value = "clliA", required = true) String clliA,
			@RequestParam(value = "clliZ", required = true) String clliZ,
			@RequestParam(value = "cableName", required = false) String fiberName,
			@RequestParam(value = "strandId", required = false) String strandId,
			@RequestParam(value = "connectionNumber", required = true) int connNumber) {
		log.info("=> getFiberConnectionInfo(): START");
		log.info(" Fiber connection request for: '{}/{}/{},{}'", clliA, clliZ, fiberName, strandId);
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");
		responseStatus.setCode(500);

		try {
			String errorMsg = "";
			if (StringUtils.isBlank(clliA) == true) {
				responseStatus.setMessage("Fibber CLLIA cannot be empty!.");
			} else if (StringUtils.isBlank(clliZ) == true) {
				responseStatus.setMessage("Fibber CLLIZ cannot be empty!.");
			} else {
				responseStatus = ethOrderSrvc.getFiberConnectionInfo(clliA, clliZ, fiberName, strandId,connNumber);
				if (responseStatus.getCode() == 200) {
					log.info("Successfully found Fiber Connection Info");
				} else {
					log.error("Failed to find Fiber Connection Info");
				}
			}

		} catch (Exception ex) {
			log.error("GetFiberConnectionInfo-Caught Exception:- '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed to get Fiber Connection Info Reason : " + ex.getMessage());
		}
		log.info("<= getFiberConnectionInfo(): END");
		return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.OK.value()));
	}

