	@GetMapping("v1/getUNIOrderInfo")
	public ResponseEntity<?> getUNIOrderInfo(@RequestParam(value = "isCircuit", required = true) boolean isCircuit,
			@RequestParam(value = "searchKey", required = true) String searchKey) {

		log.info("=>getUNIOrderInfo(): START");
		try {
			if (StringUtils.isBlank(searchKey)) {
				String msgStr = "Empty searchKey or searchValue is not allowed!";
				log.error("Failed: '{}'", msgStr);
				return new ResponseEntity<>(Map.of("code", 422, "message", msgStr), HttpStatus.UNPROCESSABLE_ENTITY);
			}
			return ethOrderSrvc.getUNIOrderInfo(searchKey, isCircuit);

		} catch (Exception ex) {
			log.error("Get UNIOrder Info - Caught Exception: '{}'", ex.getMessage(), ex);
			return new ResponseEntity<>(Map.of("code", 500, "message", "Failed : " + ex.getMessage()),
					HttpStatus.INTERNAL_SERVER_ERROR);
		} finally {
			log.info("<=getUNIOrderInfo(): END");
		}
	}

