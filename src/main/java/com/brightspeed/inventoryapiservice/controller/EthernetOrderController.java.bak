	@PostMapping(value = "/v1/getEquipmentsByLocation", consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> getEquipmentsByLocation(@RequestBody Map<String, Object> assignedInventoryBody) {
		log.info("=> getEquipmentsByLocation(): START");
		log.info(" Equipments request by Location: '{}'", assignedInventoryBody.toString());
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");

		if (assignedInventoryBody == null || assignedInventoryBody.isEmpty()) {
			ResponseStatus badRequestResponse = new ResponseStatus();
			badRequestResponse.setCode(400);
			badRequestResponse.setMessage("Bad request: Request body is missing or empty.");
			return new ResponseEntity<>(badRequestResponse, HttpStatus.BAD_REQUEST);
		}

		log.info("Equipments request by Location: '{}'", assignedInventoryBody);

		try {
			responseStatus = ethOrderSrvc.getEquipmentsByLocation(assignedInventoryBody);
			HttpStatus status;
			switch (responseStatus.getCode()) {
			case 200:
				status = HttpStatus.OK;
				break;
			case 204:
				status = HttpStatus.NO_CONTENT;
				break;
			case 400:
				status = HttpStatus.BAD_REQUEST;
				break;
			case 404:
				status = HttpStatus.NOT_FOUND;
				break;
			case 500:
			default:
				status = HttpStatus.INTERNAL_SERVER_ERROR;
				break;
			}

			log.info("<= getEquipmentsByLocation(): END");
			return new ResponseEntity<>(responseStatus, status);

		} catch (Exception ex) {
			log.error("GetEquipmentsByLocation-Caught Exception: '{}'", ex.getMessage());

			responseStatus = new ResponseStatus();
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed to get equipment. Reason: " + ex.getMessage());

			return new ResponseEntity<>(responseStatus, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}
	
