	@GetMapping("v1/isCircuitExist")
	public ResponseEntity<?> isCircuitExist(@RequestParam(value = "circuitType", required = true) String circuitType,
			@RequestParam(value = "circuitName", required = true) String circuitName) {
		log.info("=>isCircuitExist(): START");
		log.info("Checking circuit : '{}', type '{}'", circuitName, circuitType);
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setCode(500);
		responseStatus.setMessage("Failed");

		try {
			if (StringUtils.isBlank(circuitName)) {
				String msgStr = "Empty Circuit name is not allowed!.";
				log.error("Failed: '{}'", msgStr);
				responseStatus.setCode(HttpStatus.BAD_REQUEST.value());
				responseStatus.setMessage(msgStr);
			} else if (StringUtils.isBlank(circuitType)) {
				String msgStr = "Circuit Type cannot  be empty!.";
				log.error("Failed: '{}'", msgStr);
				responseStatus.setCode(HttpStatus.BAD_REQUEST.value());
				responseStatus.setMessage(msgStr);
			}
			responseStatus = ethOrderSrvc.isCircuitExist(circuitName, circuitType);

	        HttpStatus httpStatus;
	        switch (responseStatus.getCode()) {
	            case 200:
	                httpStatus = HttpStatus.OK;
	                break;
	            case 204:
	                httpStatus = HttpStatus.NO_CONTENT;
	                break;
	            case 400:
	                httpStatus = HttpStatus.BAD_REQUEST;
	                break;
	            case 404:
	                httpStatus = HttpStatus.NOT_FOUND;
	                break;
	            case 500:
	            default:
	                httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
	                break;
	        }

	        return new ResponseEntity<>(responseStatus, httpStatus);
		} catch (Exception ex) {
			log.error("Checking for circuit exist-Caught Exception:- '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed : " + ex.getMessage());
	        return new ResponseEntity<>(responseStatus, HttpStatus.INTERNAL_SERVER_ERROR);
		}
	}
	
