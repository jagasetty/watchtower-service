	@PostMapping(value = "/v1/setDeviceStatus", consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> setDeviceStatus(@RequestBody Map<String, Object> statusRequest) {
		log.info("=> setDeviceStatus (): START");
		log.info(" Update Device Status : '{}'", statusRequest.toString());
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");

		// Validate the request
		if(statusRequest == null || statusRequest.isEmpty()) {
			responseStatus.setCode(HttpStatus.UNPROCESSABLE_ENTITY.value());
			responseStatus.setMessage("DeviceName or status cannot be null or empty.");
			return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.BAD_REQUEST.value()));
		}

		String deviceName = (String) statusRequest.get("deviceName");
		String nodeId = (String) statusRequest.get("nodeId");
		String baseHeci = (String) statusRequest.get("baseHeci");
		String status = (String) statusRequest.get("status");

		// Validate Device Name
		if ((StringUtils.isBlank(deviceName)) || (StringUtils.isBlank(nodeId))
				|| (StringUtils.isBlank(baseHeci))){
			responseStatus.setCode(HttpStatus.UNPROCESSABLE_ENTITY.value());
			responseStatus.setMessage("Device Name or baseHeci cannot be null or empty.");
			return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.BAD_REQUEST.value()));
		}

		// Validate status
		if (status == null ) {
			responseStatus.setCode(HttpStatus.UNPROCESSABLE_ENTITY.value());
			responseStatus.setMessage("Status cannot be null or empty.");
			return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.BAD_REQUEST.value()));
		}

		try {
			responseStatus = ethOrderSrvc.setDeviceStatus(statusRequest);
		} catch (Exception ex) {
			log.error("setDeviceStatus -Caught Exception:- '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Failed to update Device status Reason : " + ex.getMessage());
		}
		log.info("<= setDeviceStatus (): END");
		HttpStatus httpStatus;
	    switch (responseStatus.getCode()) {
	        case 200:
	            httpStatus = HttpStatus.OK;
	            break;
	        case 400:
	            httpStatus = HttpStatus.BAD_REQUEST;
	            break;
	        case 404:
	            httpStatus = HttpStatus.NOT_FOUND;
	            break;
	        default:
	            httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
	            break;
	    }
	    return new ResponseEntity<>(responseStatus, httpStatus);
	}

