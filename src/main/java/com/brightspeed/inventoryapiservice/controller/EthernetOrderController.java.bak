	@PostMapping(value = "/v1/validateEVCSpeed",consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> validateEVCSpeed(@RequestBody Map<String, Object> validateRquest){
		log.info("=> validateEVCSpeed(): START");
		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");
		responseStatus.setCode(500);

		if (validateRquest == null || validateRquest.isEmpty()) {
			ResponseStatus badRequestResponse = new ResponseStatus();
			badRequestResponse.setCode(400);
			badRequestResponse.setMessage("Bad request: Request body is missing or empty.");
			return new ResponseEntity<>(badRequestResponse, HttpStatus.BAD_REQUEST);
		}


		try {
			responseStatus = ethOrderSrvc.validateEVCSpeed(validateRquest);
		}catch(Exception ex) {
			responseStatus.setMessage("Failed");
			responseStatus.setCode(500);
		}
		log.info("<= validateEVCSpeed(): END");
		return new ResponseEntity<>(responseStatus, HttpStatus.valueOf(HttpStatus.OK.value()));
	}
}
