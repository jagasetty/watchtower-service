	@PostMapping(value = "/v1/createNmiInE2")
	public ResponseEntity<?> createNmiInE2(@RequestParam(value = "circuit", required = false) String circuit) {
	    log.info("=>createNmiInE2(): START");
	    log.info("createNmiInE2: '{}'", circuit);

	    if (StringUtils.isBlank(circuit)) {
	        String msgStr = "Empty circuit name is not allowed.";
	        log.error("Failed: '{}'", msgStr);
	        return ResponseEntity.badRequest().body(Map.of("error", msgStr));
	    }

	    try {
	        Map<String, Object> response = ethOrderSrvc.createNmiInE2(circuit);
	        log.error("createNmiInE2 response: '{}'", response);
	        return ResponseEntity.ok(response);
	    }  catch (RuntimeException ex) {
	        String message = ex.getMessage();
	        log.error("Caught RuntimeException: {}", message, ex);

	        if (message != null && message.contains("{") && message.contains("}")) {
	            try {
	                int start = message.indexOf("{");
	                String jsonPart = message.substring(start);
	                ObjectMapper mapper = new ObjectMapper();
	                Map<String, String> errorMap = mapper.readValue(jsonPart, new TypeReference<>() {});
	                String e2Message = errorMap.getOrDefault("message", "Unknown error");
	                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
	                        .body(Map.of("error", "E2 Error: " + e2Message));
	            } catch (Exception parseEx) {
	                log.error("Failed to parse E2 error JSON: {}", message);
	                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
	                        .body(Map.of("error", message));
	            }
	        } else {
	            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
	                    .body(Map.of("error", message));
	        }
	    }

	    catch (Exception ex) {
	        log.error("Neo4j error in createNmiInE2('{}'): {}", ex.getMessage(), ex);
	        throw new RuntimeException("Failed to createNmiInE2", ex);
	    }finally {
	        log.info("<=createNmiInE2(): END");
	    }
	}


	@PostMapping(value = "/v1/removeUniFromEVPLAN", consumes = MediaType.APPLICATION_JSON_VALUE)
	public ResponseEntity<?> removeUniFromEVPLAN(@RequestBody Map<String, Object> evcInfo) {
		log.info("=> removeUniFromEVPLAN(): START");
		log.info("Input : '{}'", evcInfo.toString());

		ResponseStatus responseStatus = new ResponseStatus();
		responseStatus.setMessage("Failed");
		responseStatus.setCode(500);

		try {
			String evcName = (String) evcInfo.get("evcName");
			String uniName = (String) evcInfo.get("uniName");

			if (StringUtils.isBlank(evcName)) {
				responseStatus.setMessage("Failed. EVC Name should not be empty!");
				responseStatus.setCode(400);
			} else if (StringUtils.isBlank(uniName)) {
				responseStatus.setMessage("Failed. UNI Circuit Name should not be empty!");
				responseStatus.setCode(400);
			}

			responseStatus = ethOrderSrvc.removeUniFromEVPLAN(evcName, uniName);

		} catch (Exception ex) {
			log.error("removeUniFromEVPLAN - Exception: '{}'", ex.getMessage());
			responseStatus.setCode(500);
			responseStatus.setMessage("Error occurred: " + ex.getMessage());
		}

		log.info("<= removeUniFromEVPLAN(): END");
		HttpStatus httpStatus;
		switch (responseStatus.getCode()) {
		case 200:
			httpStatus = HttpStatus.OK;
			break;
		case 400:
			httpStatus = HttpStatus.BAD_REQUEST;
			break;
		case 404:
			httpStatus = HttpStatus.NOT_FOUND;
			break;
		default:
			httpStatus = HttpStatus.INTERNAL_SERVER_ERROR;
			break;
		}
		return new ResponseEntity<>(responseStatus, httpStatus);
	}

	@PostMapping(value = "/v1/createUNIInE2")
	public ResponseEntity<ResponseStatus> createUNIInE2(
	        @RequestParam(value = "circuit", required = false) String circuit) {

	    log.info("=> createUNIInE2(): START");
	    log.info("Received circuit: '{}'", circuit);

	    if (StringUtils.isBlank(circuit)) {
	        String msgStr = "Empty circuit name is not allowed.";
	        log.error("Validation failed: '{}'", msgStr);

	        ResponseStatus status = new ResponseStatus();
	        status.setCode(400);
	        status.setMessage(msgStr);
	        return ResponseEntity.badRequest().body(status);
	    }

	    try {
	        ResponseStatus response = ethOrderSrvc.createUNIInE2(circuit);

	        if (response.getCode() == 200) {
	            return ResponseEntity.ok(response);
	        } else {
	            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(response);
	        }

	    } catch (RuntimeException ex) {
	        String errorMsg = "Error occurred while creating UNI in E2";
	        log.error("{}: {}", errorMsg, ex.getMessage(), ex);

	        ResponseStatus status = new ResponseStatus();
	        status.setCode(500);
	        status.setMessage(errorMsg + ": " + ex.getMessage());
	        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(status);
	    }
	}
	
